{
  "version": 8,
  "name": "Zenvoria",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "Mapa ZENVORIA · data © <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\" rel=\"noopener\">OpenStreetMap</a> přispěvatelé"
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#EEF3EC" } },

    { "id": "landcover-wood", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["==", "class", "wood"], "paint": { "fill-color": "#CFE0C6", "fill-opacity": 0.7 } },
    { "id": "landcover-grass", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["in", "class", "grass", "farmland"], "paint": { "fill-color": "#E4EDE2", "fill-opacity": 0.6 } },

    { "id": "landuse-residential", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["==", "class", "residential"], "paint": { "fill-color": "#E9E2C9", "fill-opacity": 0.35 }, "minzoom": 8 },
    { "id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park",
      "paint": { "fill-color": "#D9E7CE", "fill-opacity": 0.6 } },

    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "filter": ["!=", "intermittent", 1], "paint": { "fill-color": "#0E7A45" } },
    { "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway",
      "paint": { "line-color": "#0E7A45", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 16, 2] } },

    { "id": "boundary-state", "type": "line", "source": "openmaptiles", "source-layer": "boundary",
      "filter": ["all", ["==", "admin_level", 4], ["!=", "maritime", 1]],
      "paint": { "line-color": "#0E7A45", "line-width": 1, "line-dasharray": [3, 2], "line-opacity": 0.5 }, "minzoom": 5 },
    { "id": "boundary-country", "type": "line", "source": "openmaptiles", "source-layer": "boundary",
      "filter": ["all", ["<=", "admin_level", 2], ["!=", "maritime", 1]],
      "paint": { "line-color": "#0A5A34", "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.6, 10, 1.6], "line-opacity": 0.6 } },

    { "id": "building", "type": "fill", "source": "openmaptiles", "source-layer": "building",
      "minzoom": 14, "paint": { "fill-color": "#E9DEC3", "fill-outline-color": "#C9A233", "fill-opacity": 0.9 } },

    { "id": "road-path", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "path", "track"], "minzoom": 14,
      "paint": { "line-color": "#B7AE93", "line-width": 1, "line-dasharray": [2, 2] } },
    { "id": "road-minor-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service"], "minzoom": 12,
      "paint": { "line-color": "#D7CBA3", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1.5, 18, 6] } },
    { "id": "road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service"], "minzoom": 12,
      "paint": { "line-color": "#F3ECD8", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.6, 18, 4] } },
    { "id": "road-secondary-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "tertiary", "secondary"],
      "paint": { "line-color": "#A98821", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 16, 7] } },
    { "id": "road-secondary", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "tertiary", "secondary"],
      "paint": { "line-color": "#DEBB5A", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 16, 5] } },
    { "id": "road-primary-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "paint": { "line-color": "#A98821", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1, 16, 8.5] } },
    { "id": "road-primary", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "paint": { "line-color": "#C9A233", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.8, 16, 6.5] } },
    { "id": "road-trunk-motorway-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "trunk", "motorway"],
      "paint": { "line-color": "#0A5A34", "line-width": ["interpolate", ["linear"], ["zoom"], 4, 1, 16, 9.5] } },
    { "id": "road-trunk-motorway", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "trunk", "motorway"],
      "paint": { "line-color": "#A98821", "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.8, 16, 7.5] } },

    { "id": "road-name", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name",
      "filter": ["in", "class", "primary", "secondary", "tertiary", "trunk", "motorway"], "minzoom": 13,
      "layout": { "symbol-placement": "line", "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"], "text-size": 11 },
      "paint": { "text-color": "#7A5E10", "text-halo-color": "#F6F1E0", "text-halo-width": 1.4 } },

    { "id": "place-village", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
      "filter": ["in", "class", "village", "hamlet", "suburb", "neighbourhood"], "minzoom": 11,
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 16, 13] },
      "paint": { "text-color": "#3E5C46", "text-halo-color": "#EEF3EC", "text-halo-width": 1.3 } },
    { "id": "place-town", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
      "filter": ["==", "class", "town"], "minzoom": 8,
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 11, 14, 15] },
      "paint": { "text-color": "#0E7A45", "text-halo-color": "#EEF3EC", "text-halo-width": 1.4 } },
    { "id": "place-city", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
      "filter": ["==", "class", "city"], "minzoom": 4,
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 12, 12, 18] },
      "paint": { "text-color": "#0A5A34", "text-halo-color": "#FFFFFF", "text-halo-width": 1.6 } }
  ]
}
