# ZENVORIA — proměnné prostředí
# Na Railway nastav tyto hodnoty v sekci Variables. Lokálně si vytvoř soubor .env (je v .gitignore).

# --- Supabase (povinné pro běh s databází) ---
SUPABASE_URL=https://xnouphqbepljogztwgxj.supabase.co
# TAJNÝ service_role klíč (sb_secret_...). NIKDY ho nedávej do frontendu! Supabase → Settings → API → Secret keys
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Volitelné ---
# Podpis session cookie. Na produkci nastav vlastní náhodný řetězec (jinak se generuje za běhu a po restartu odhlásí uživatele).
SESSION_SECRET=
# Port (Railway si nastaví sám)
PORT=3000
# Timeout REST volání na Supabase (ms)
SUPABASE_REST_TIMEOUT_MS=10000

# --- Názvy tabulek (volitelné, mají fallback na zenvoria_*) ---
# TBL_USERS=zenvoria_users
# TBL_CAREGIVERS=zenvoria_caregivers
# TBL_VERIFICATIONS=zenvoria_verifications
# TBL_ORDERS=zenvoria_orders
# TBL_REQUESTS=zenvoria_requests
# TBL_SCHEDULE=zenvoria_schedule
# TBL_REVIEWS=zenvoria_reviews
# TBL_CONVERSATIONS=zenvoria_conversations
# TBL_MESSAGES=zenvoria_messages
# TBL_BROADCASTS=zenvoria_broadcasts
# TBL_SETTINGS=zenvoria_settings
