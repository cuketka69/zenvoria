# ZENVORIA - promenne prostredi
# Na Railway nastav tyto hodnoty v sekci Variables. Lokalně si vytvor soubor .env.

# --- Supabase (povinne pro beh s databazi) ---
SUPABASE_URL=https://xnouphqbepljogztwgxj.supabase.co
# Tajny service_role klic (sb_secret_...). Nikdy ho nedavej do frontendu.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Volitelne ---
# Podpis session cookie. Na produkci nastav vlastni nahodny retezec.
SESSION_SECRET=
# Port (Railway si nastavi sam)
PORT=3000
# Timeout REST volani na Supabase (ms)
SUPABASE_REST_TIMEOUT_MS=10000

# --- E-mailing pres Resend (volitelne) ---
# Zapne/vypne pokus o odeslani e-mailu z backendu
MAIL_ENABLED=true
# API klic z Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Odesilatel, ktery mas overeny v Resend
MAIL_FROM=ZENVORIA <noreply@tvoje-domena.cz>

# --- Stripe (predplatne PREMIUM pro pecovatelky) ---
# Tajny API klic z https://dashboard.stripe.com/apikeys
# format: "sk_test_..." (test) nebo "sk_live_..." (produkce). NIKDY do frontendu.
STRIPE_SECRET_KEY=
# Podpisovy tajny klic webhooku (Stripe -> Developers -> Webhooks), format "whsec_..."
STRIPE_WEBHOOK_SECRET=
# Cena se posila dynamicky z aplikace (admin -> Tarify), produkt ve Stripe se zaklada sam.
# Menu (default czk). Meni jen kdyz uctujes v jine mene.
# STRIPE_CURRENCY=czk
# Verejna URL aplikace (pro navrat z Checkoutu). Bez lomitka na konci.
APP_URL=https://www.zenvoria.cz

# --- Rate limiting auth endpointu (volitelne) ---
# Registrace: max 5 pokusu za 60 minut
# RATE_LIMIT_REGISTER_WINDOW_MS=3600000
# RATE_LIMIT_REGISTER_MAX=5
# Login: max 10 pokusu za 15 minut
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
# RATE_LIMIT_LOGIN_MAX=10
# Forgot password: max 5 pokusu za 30 minut
# RATE_LIMIT_FORGOT_PASSWORD_WINDOW_MS=1800000
# RATE_LIMIT_FORGOT_PASSWORD_MAX=5
# Reset password / validate: max 10 pokusu za 30 minut
# RATE_LIMIT_RESET_PASSWORD_WINDOW_MS=1800000
# RATE_LIMIT_RESET_PASSWORD_MAX=10
# Change password: max 10 pokusu za 30 minut
# RATE_LIMIT_CHANGE_PASSWORD_WINDOW_MS=1800000
# RATE_LIMIT_CHANGE_PASSWORD_MAX=10
# Change email request: max 5 pokusu za 30 minut
# RATE_LIMIT_CHANGE_EMAIL_REQUEST_WINDOW_MS=1800000
# RATE_LIMIT_CHANGE_EMAIL_REQUEST_MAX=5
# Change email code / validate / confirm: max 10 pokusu za 15 minut
# RATE_LIMIT_CHANGE_EMAIL_CODE_WINDOW_MS=900000
# RATE_LIMIT_CHANGE_EMAIL_CODE_MAX=10

# --- Nazvy tabulek (volitelne, maji fallback na zenvoria_*) ---
# TBL_USERS=zenvoria_users
# TBL_CAREGIVERS=zenvoria_caregivers
# TBL_VERIFICATIONS=zenvoria_verifications
# TBL_ORDERS=zenvoria_orders
# TBL_REQUESTS=zenvoria_requests
# TBL_SCHEDULE=zenvoria_schedule
# TBL_REVIEWS=zenvoria_reviews
# TBL_CONVERSATIONS=zenvoria_conversations
# TBL_MESSAGES=zenvoria_messages
# TBL_BROADCASTS=zenvoria_broadcasts
# TBL_SETTINGS=zenvoria_settings
# TBL_AUDIT_LOGS=zenvoria_audit_logs
